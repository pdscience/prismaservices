# InsForge (frontend - exposto pelo Vite)
VITE_INSFORGE_URL=https://seu-projeto.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=anon_sua_chave_anon_key

# Landing premium / conversão (opcionais — placeholders seguros)
VITE_WHATSAPP_NUMBER=5511999999999
VITE_GTM_ID=
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_HERO_VIDEO_URL=

# 'test' ou 'live'. Use 'live' no build de producao.
VITE_STRIPE_ENVIRONMENT=test

# As secrets abaixo sao gerenciadas no InsForge (nao no frontend):
#   STRIPE_TEST_SECRET_KEY, STRIPE_TEST_WEBHOOK_SECRET,
#   STRIPE_LIVE_SECRET_KEY, STRIPE_LIVE_WEBHOOK_SECRET,
#   NVIDIA_API_KEY, NVIDIA_BASE_URL, NVIDIA_MODEL, INSFORGE_BASE_URL, ANON_KEY

# Stripe Prices (IDs dos Prices recorrentes; ver tabela public.plan_prices).
# ATENÇÃO: cada plano precisa do SEU próprio price. Nunca reuse o mesmo ID em
# dois planos (foi o que aconteceu com Bronze/Gratuito). Gratuito não tem price.
#   STRIPE_OURO_PRICE_ID=price_...
#   STRIPE_PRATA_PRICE_ID=price_...
#   STRIPE_BRONZE_PRICE_ID=price_...
#   (sem STRIPE_GRATUITO_PRICE_ID — plano gratuito não é vendido)
